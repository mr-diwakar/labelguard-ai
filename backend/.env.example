# Copy this file to .env and adjust the values for your machine.
# .env holds real settings and is git-ignored. Never commit it.

# Shown in the OpenAPI docs.
APP_NAME=LabelGuard AI

# development | staging | production. Controls autoreload when running main.py.
APP_ENV=development

# Network interface the API binds to. Use 0.0.0.0 to accept traffic from a phone
# on the same network.
HOST=127.0.0.1

# Port the API listens on.
PORT=8000

# Comma-separated origins allowed to call the API from a browser.
# Leave empty to send no CORS headers at all.
CORS_ORIGINS=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# PostgreSQL DSN. Never commit a real password. Do not log this value.
# A bare postgresql:// URL is rewritten to postgresql+psycopg:// on load.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/labelguard
