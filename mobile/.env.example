# Copy this file to `.env` in this folder to pin the backend.
# Expo inlines EXPO_PUBLIC_* at bundle time — restart Expo after changing this.
# Never commit `.env`.
#
# Physical Android/iOS device (phone and PC on the same Wi-Fi):
#   EXPO_PUBLIC_API_URL=http://<PC-LAN-IP>:8000
#
# Android emulator:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
# Do NOT use localhost or 127.0.0.1 on a physical device — those addresses
# are the phone itself, not the development PC.
#
# If this variable is omitted, the app uses the Expo/Metro bundler host
# (the PC Expo Go already connected to) on port 8000.

# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
